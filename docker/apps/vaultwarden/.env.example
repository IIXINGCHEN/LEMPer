# Copy to .env and fill in. Generate the admin token with:
#   openssl rand -base64 48

# Admin panel token (REQUIRED — the lemper CLI generates one if left empty).
ADMIN_TOKEN=

# Allow public sign-ups? Keep false; create users from the admin panel.
SIGNUPS_ALLOWED=false

# Public-facing URL, e.g. https://vault.example.com (used in emails/2FA).
DOMAIN=

# Host port for the web UI (default 8000).
VAULT_PORT=8000
